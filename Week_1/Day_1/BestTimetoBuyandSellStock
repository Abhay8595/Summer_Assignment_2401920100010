class Solution {
    public int maxProfit(int[] prices) {
        int n=prices.length;
        int maxprofit=0;
        int max=prices[n-1]; 
        for(int i=n-2;i>=0;i--){
            max=Math.max(max,prices[i]);
            maxprofit=Math.max(maxprofit,max-prices[i]);
        }

        return maxprofit;
    }
}
